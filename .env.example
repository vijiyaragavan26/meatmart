# Store Configuration (Kanjikovil, Erode, Tamil Nadu)
STORE_NAME="MeatMart Fresh Meats & Masalas"
STORE_LATITUDE=11.3925317
STORE_LONGITUDE=77.6085870
STORE_ADDRESS="Main Road, Kanjikovil, Erode District, Tamil Nadu 638116"
STORE_PHONE="+91 98427 12345"
STORE_EMAIL="support@meatmartkanjikovil.in"

# Payment Gateways (Razorpay / Cashfree)
